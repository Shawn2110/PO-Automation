# Copy to .env and fill in.

# Prisma — use Supabase or any Postgres for prod; SQLite still works for quick local hacking.
DATABASE_URL="postgresql://postgres:password@localhost:5432/po_automation"
# Required only if DATABASE_URL points at a pooler (Supabase Supavisor port 6543).
# Direct connection (port 5432) — used by Prisma migrate only.
DIRECT_URL="postgresql://postgres:password@localhost:5432/po_automation"

# Auth.js v5 — generate a fresh secret with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Modal VLM sidecar (see ../modal-vlm/README.md)
MODAL_VLM_URL="https://<your-username>--po-automation-vlm-web.modal.run"
MODAL_AUTH_TOKEN="paste-the-same-value-as-the-modal-secret"

# Local file storage (swap to MinIO/S3 in production)
UPLOAD_DIR="./uploads"

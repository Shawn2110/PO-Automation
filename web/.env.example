# Copy to .env and fill in.

# Prisma — SQLite for the demo. Swap to Postgres for production.
DATABASE_URL="file:./dev.db"

# Auth.js v5 — generate a fresh secret with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# OCR sidecar (Python FastAPI)
OCR_SERVICE_URL="http://127.0.0.1:8001"

# Local file storage (swap to MinIO/S3 in production)
UPLOAD_DIR="./uploads"
